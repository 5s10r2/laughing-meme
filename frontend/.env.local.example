# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and never committed.

# URL of the running backend (FastAPI).
# Local dev: http://localhost:8001
# Production: https://tarini-backend-d79e.onrender.com
NEXT_PUBLIC_BACKEND_URL=http://localhost:8001

# Enable the redesigned experience (new UI shell + Living Blueprint panel).
# Must match the backend USE_NEW_EXPERIENCE flag — set both together.
# Leave unset (or set to "0") to run the legacy stepper UI.
NEXT_PUBLIC_USE_NEW_EXPERIENCE=1

# Bearer token sent to the backend on every API request.
# Must match the backend TARINI_API_KEY env var if one is set.
# Leave unset for local dev if the backend has no auth configured.
TARINI_API_KEY=
