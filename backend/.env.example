ANTHROPIC_API_KEY=your_anthropic_api_key_here
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Auth — set a strong random string in production (openssl rand -hex 32).
# Must match TARINI_API_KEY in the frontend .env.local.
# Leave unset in local dev to disable the check.
TARINI_API_KEY=

# CORS — comma-separated list of allowed frontend origins.
# Defaults to http://localhost:3000 when unset.
CORS_ORIGINS=http://localhost:3000

# Local development only. Never enable this in production.
ALLOW_IN_MEMORY_DB=false

# Redesigned backend (intent/command architecture). Off by default → the live, verified
# path runs. Set to true to route through the new CommandService/tool layer.
# PREREQUISITE: apply db/migrations/0002_property_redesign.sql to Supabase BEFORE enabling
# this in any environment backed by Supabase, or apply_commands will fail (RPC not found).
# Flipping this back to false is an instant rollback to the verified baseline.
USE_NEW_EXPERIENCE=false
